# =============================================
# MoneyFlowID Bot - Environment Configuration
# =============================================
# Salin file ini menjadi .env dan isi nilainya
# Copy this file to .env and fill in the values

# ----------------------------
# Telegram Bot Token
# Dapatkan dari @BotFather di Telegram
# Get from @BotFather on Telegram
# ----------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ----------------------------
# Gemini AI API Key
# Dapatkan dari https://aistudio.google.com/
# Get from https://aistudio.google.com/
# ----------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ----------------------------
# ChatGPT (OpenAI) API Key (opsional / optional)
# Dapatkan dari https://platform.openai.com/api-keys
# Get from https://platform.openai.com/api-keys
# ----------------------------
OPENAI_API_KEY=your_openai_api_key_here

# ----------------------------
# Groq API Key (opsional / optional)
# Dapatkan dari https://console.groq.com/keys
# Get from https://console.groq.com/keys
# ----------------------------
GROQ_API_KEY=your_groq_api_key_here

# ----------------------------
# Google Service Account Credentials
# Path ke file JSON credentials Google Service Account
# Path to Google Service Account credentials JSON file
# ----------------------------
GOOGLE_CREDENTIALS_PATH=./credentials/google-credentials.json

# ----------------------------
# Admin Telegram User ID (opsional / optional)
# Untuk akses perintah admin (broadcast, panel admin)
# For admin command access (broadcast, admin panel)
# Cara cek ID kamu: chat dengan @userinfobot di Telegram
# How to check your ID: chat with @userinfobot on Telegram
# ----------------------------
BOT_ADMIN_ID=your_telegram_user_id_here

# ----------------------------
# Bahasa default bot (id / en)
# Default bot language (id / en)
# ----------------------------
DEFAULT_LANGUAGE=id

# ----------------------------
# Timezone untuk reminder tagihan
# Timezone for bill reminders (e.g. Asia/Jakarta)
# Daftar timezone: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# ----------------------------
TIMEZONE=Asia/Jakarta

# ----------------------------
# Log Level (debug / info / warn / error)
# Default: info
# ----------------------------
LOG_LEVEL=info
