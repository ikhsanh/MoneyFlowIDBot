# =============================================
# MoneyFlowID Bot - Environment Configuration
# =============================================
# Salin file ini menjadi .env dan isi nilainya
# Copy this file to .env and fill in the values

# ----------------------------
# Telegram Bot Token
# Dapatkan dari @BotFather di Telegram
# Get from @BotFather on Telegram
# ----------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ----------------------------
# Gemini AI API Key
# Dapatkan dari https://aistudio.google.com/
# Get from https://aistudio.google.com/
# ----------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash


# ----------------------------
# Google Service Account Credentials
# Path ke file JSON credentials Google Service Account
# Path to Google Service Account credentials JSON file
# ----------------------------
GOOGLE_CREDENTIALS_PATH=./credentials/google-credentials.json

# ----------------------------
# Admin Telegram User ID (opsional / optional)
# Untuk akses perintah admin
# For admin command access
# ----------------------------
BOT_ADMIN_ID=123456789

# ----------------------------
# Bahasa default bot (id / en)
# Default bot language (id / en)
# ----------------------------
DEFAULT_LANGUAGE=id

# ----------------------------
# Timezone untuk reminder tagihan
# Timezone for bill reminders (e.g. Asia/Jakarta)
# ----------------------------
TIMEZONE=Asia/Jakarta
